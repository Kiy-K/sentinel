# --- Sentinel configuration (copy to .env, fill in, never commit .env) ---

# REQUIRED: OpenRouter API key used by the fix agent's LLM (openrouter.ai/keys)
OPENROUTER_API_KEY=

# REQUIRED: shared secret for the GitHub webhook (x-hub-signature-256). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# REQUIRED on a Sprite: Sprites gateway URL for GitHub git-data API access
# (the gateway injects OAuth — no GitHub token is stored here)
GITHUB_GATEWAY_URL=

# Comma-separated owner/repo allowlist (defaults to the hackathon fixture repo)
SENTINEL_ALLOWED_REPOS=Kiy-K/night-shift-demo

# Optional overrides
# SENTINEL_MODEL=openrouter/openrouter/free   # any OpenRouter model slug
# SENTINEL_DATA_DIR=./data                    # SQLite + work dirs
# PORT=8080
